rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read/write for development (TEMPORARY - CHANGE FOR PRODUCTION)
    match /{document=**} {
      allow read, write: if true;
    }
  }
  
  match /emergencies/{id} {
  allow read: if request.auth != null &&
    request.auth.token.role in ['emergency','doctor','admin'];

  allow write: if request.auth != null &&
    request.auth.token.role == 'emergency';
}

match /triage/{id} {
  allow read: if request.auth != null;
  allow write: if request.auth != null &&
    request.auth.token.role in ['emergency','doctor'];
}

match /beds/{id} {
  allow read: if request.auth != null;
  allow write: if request.auth != null &&
    request.auth.token.role == 'emergency';
}

}