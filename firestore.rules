rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function dataPath(name, id) { return /databases/$(database)/documents/$(name)/$(id); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function active() {
      let profile = signedIn() ? me() : null;
      return signedIn() && request.auth.token.email_verified == true &&
        profile.schemaVersion == 2 && profile.accountStatus == 'active';
    }
    function role(value) { return active() && me().role == value; }
    // A browser flag or simulated OTP is NOT MFA. Identity Platform must issue
    // a second-factor claim before privileged administrator actions are allowed.
    function admin() {
      return role('admin') && request.auth.token.firebase.get('sign_in_second_factor', '') == 'totp' &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }
    function reception() { return role('receptionist') || admin(); }
    function staff() { return active() && me().role in ['doctor', 'receptionist', 'lab'] || admin(); }
    function bounded() { return request.query.limit != null && request.query.limit <= 100; }
    function text(value, maximum) { return value is string && value.size() <= maximum; }
    function id(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$'); }
    function minor(value) { return value is int && value >= 0 && value <= 100000000000; }
    function date(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function file(value) {
      return value is map && value.keys().hasOnly(['name', 'mimeType', 'encoding', 'originalBytes', 'base64', 'sha256']) &&
        text(value.name, 150) && value.name.size() > 0 && value.encoding == 'gzip-base64' &&
        value.mimeType in ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'] &&
        value.originalBytes is int && value.originalBytes > 0 && value.originalBytes <= 5000000 &&
        value.base64 is string && value.base64.size() > 0 && value.base64.size() <= 600000 &&
        value.base64.matches('^[A-Za-z0-9+/]+={0,2}$') && value.sha256 is string && value.sha256.matches('^[a-f0-9]{64}$');
    }
    function audit(d, actions) {
      let log = getAfter(dataPath('auditLogs', d.lastAuditId)).data;
      return id(d.lastAuditId) && log.schemaVersion == 2 && log.actorId == request.auth.uid &&
        log.timestamp == request.time && log.action in actions;
    }
    function createStamp(d) {
      return d.schemaVersion == 2 && d.revision == 1 && d.createdAt == request.time &&
        d.updatedAt == request.time && d.createdBy == request.auth.uid && d.updatedBy == request.auth.uid;
    }
    function updateStamp(d) {
      return d.get('schemaVersion', 0) == 2 && d.get('revision', 0) == resource.data.get('revision', 0) + 1 &&
        d.updatedAt == request.time && d.updatedBy == request.auth.uid &&
        d.createdAt == resource.data.createdAt && d.createdBy == resource.data.createdBy;
    }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        fields.concat(['revision', 'updatedAt', 'updatedBy', 'lastAuditId', 'schemaVersion']));
    }
    function owns(d) { return signedIn() && d.patientId == request.auth.uid; }
    function treating(d) { return role('doctor') && d.doctorId == request.auth.uid; }
    function clinicalRead(d) { return active() && (owns(d) || treating(d) || admin()); }
    function activeVisit(id) {
      let visit = get(dataPath('visits', id)).data;
      return visit.status == 'active' && visit.locked == false && visit.doctorId == request.auth.uid;
    }

    match /users/{uid} {
      function validProfile(d) {
        return d.uid == uid && d.role in ['patient', 'doctor', 'receptionist', 'lab', 'admin'] &&
          text(d.fullName, 100) && d.fullName.size() > 0 &&
          (d.email == null || text(d.email, 254)) &&
          (d.phone == '' || d.phone.matches('^[+]923[0-9]{9}$')) &&
          (d.emergencyContact == '' || d.emergencyContact.matches('^[+]923[0-9]{9}$')) &&
          (d.cnic == '' || d.cnic.matches('^[0-9]{5}-[0-9]{7}-[0-9]$')) &&
          (d.dateOfBirth == '' || date(d.dateOfBirth)) &&
          d.gender in ['', 'male', 'female', 'other'] &&
          d.bloodGroup in ['', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'] &&
          text(d.address, 500) && minor(d.baseSalaryMinor) && d.accountStatus in ['active', 'disabled'] &&
          d.keys().hasOnly(['uid', 'email', 'role', 'fullName', 'phone', 'cnic', 'dateOfBirth', 'gender', 'address',
            'emergencyContact', 'bloodGroup', 'accountStatus', 'activeVisitId', 'currentBedId', 'departmentId',
            'department', 'specialization', 'licenseNumber', 'baseSalaryMinor', 'employmentStartDate', 'employmentEndDate', 'careTeamIds',
            'payrollPolicy', 'schemaVersion', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
            'lastAuditId', 'lastLogin', 'statusReason']);
      }
      function canRead() {
        return signedIn() && (request.auth.uid == uid || admin() || role('receptionist') && resource.data.role == 'patient' ||
          role('doctor') && resource.data.role == 'patient' && resource.data.careTeamIds.hasAny([request.auth.uid]));
      }
      allow get: if canRead();
      allow list: if bounded() && (admin() || role('receptionist') && resource.data.role == 'patient');
      allow create: if signedIn() && validProfile(request.resource.data) && createStamp(request.resource.data) &&
        request.resource.data.role != 'admin' && request.resource.data.accountStatus == 'active' &&
        request.resource.data.activeVisitId == null && request.resource.data.currentBedId == null &&
        audit(request.resource.data, ['USER_REGISTERED', 'STAFF_CREATED']) &&
        (uid == request.auth.uid && request.resource.data.role == 'patient' && request.resource.data.email == request.auth.token.email &&
          request.resource.data.baseSalaryMinor == 0 && request.resource.data.departmentId == null ||
         admin() || role('receptionist') && request.resource.data.role == 'patient');
      allow update: if signedIn() && request.resource.data.role == resource.data.role && validProfile(request.resource.data) && (
        // Login timestamp is recorded atomically with a corresponding auth audit.
        request.auth.uid == uid && active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']) &&
          request.resource.data.lastLogin == request.time ||
        updateStamp(request.resource.data) && (
          (request.auth.uid == uid && active() || reception() && resource.data.role == 'patient') &&
            changedOnly(['fullName', 'phone', 'cnic', 'dateOfBirth', 'gender', 'address', 'emergencyContact', 'bloodGroup']) &&
            audit(request.resource.data, ['PROFILE_UPDATED']) ||
          (request.auth.uid == uid && role('patient') || reception()) && resource.data.role == 'patient' && changedOnly(['careTeamIds']) &&
            request.resource.data.careTeamIds is list && request.resource.data.careTeamIds.size() <= 50 &&
            audit(request.resource.data, ['APPOINTMENT_CREATED']) &&
            request.resource.data.careTeamIds.toSet() == resource.data.careTeamIds.toSet().union([
              getAfter(dataPath('appointments', getAfter(dataPath('auditLogs', request.resource.data.lastAuditId)).data.targetId)).data.doctorId].toSet()) ||
          admin() && resource.data.role in ['doctor', 'receptionist', 'lab'] &&
            changedOnly(['accountStatus', 'statusReason', 'baseSalaryMinor', 'payrollPolicy']) &&
            audit(request.resource.data, ['STAFF_STATUS_CHANGED', 'PAYROLL_POLICY_UPDATED']) ||
          role('doctor') && resource.data.role == 'patient' && changedOnly(['activeVisitId']) &&
            audit(request.resource.data, ['VISIT_CREATED', 'VISIT_DISCHARGED']) && (
              request.resource.data.activeVisitId != null &&
                getAfter(dataPath('visits', request.resource.data.activeVisitId)).data.patientId == uid &&
                getAfter(dataPath('visits', request.resource.data.activeVisitId)).data.doctorId == request.auth.uid &&
                getAfter(dataPath('visits', request.resource.data.activeVisitId)).data.status == 'active' ||
              request.resource.data.activeVisitId == null &&
                getAfter(dataPath('visits', resource.data.activeVisitId)).data.status == 'discharged' &&
                getAfter(dataPath('visits', resource.data.activeVisitId)).data.locked == true) ||
          reception() && resource.data.role == 'patient' && changedOnly(['currentBedId']) &&
            audit(request.resource.data, ['BED_ASSIGNED', 'BED_RELEASED']) && (
              request.resource.data.currentBedId != null && getAfter(dataPath('beds', request.resource.data.currentBedId)).data.patientId == uid ||
              request.resource.data.currentBedId == null && getAfter(dataPath('beds', resource.data.currentBedId)).data.patientId == null)
        )
      );
      allow delete: if false;
    }

    match /departments/{departmentId} {
      function valid(d) {
        return text(d.name, 100) && d.name.size() > 0 && d.active is bool && d.emergencyEnabled is bool &&
          d.doctorIds is list && d.doctorIds.size() <= 100 && d.doctorProfiles is map && d.staffProfiles is map &&
          d.services is map && d.services.size() <= 100 && d.revenueMinor is int && d.revenueMinor >= 0 && d.revenueMinor <= 9007199254740991 &&
          d.revenue == d.revenueMinor / 100.0 && d.collectedRevenue == d.revenue &&
          d.keys().hasOnly(['name', 'active', 'emergencyEnabled', 'headDoctorId', 'doctorIds', 'doctorProfiles', 'staffProfiles',
            'services', 'revenueMinor', 'revenue', 'collectedRevenue', 'lastPaidInvoiceId', 'schemaVersion', 'revision',
            'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'lastAuditId']);
      }
      // Catalogs are authenticated; public reads of users would expose payroll/PII.
      allow get: if active();
      allow list: if active() && bounded();
      allow create: if admin() && valid(request.resource.data) && createStamp(request.resource.data) &&
        request.resource.data.revenueMinor == 0 && request.resource.data.doctorIds.size() == 0 &&
        request.resource.data.services.size() == 0 && audit(request.resource.data, ['DEPARTMENT_CREATED']);
      allow update: if updateStamp(request.resource.data) && valid(request.resource.data) && (
        admin() && changedOnly(['name', 'active', 'emergencyEnabled', 'headDoctorId', 'doctorIds', 'doctorProfiles', 'staffProfiles', 'services']) &&
          audit(request.resource.data, ['STAFF_CREATED', 'STAFF_STATUS_CHANGED', 'DEPARTMENT_SERVICE_UPDATED', 'DOCTOR_SCHEDULE_UPDATED']) ||
        reception() && changedOnly(['revenueMinor', 'revenue', 'collectedRevenue', 'lastPaidInvoiceId']) &&
          audit(request.resource.data, ['PAYMENT_CONFIRMED']) &&
          get(dataPath('invoices', request.resource.data.lastPaidInvoiceId)).data.status != 'paid' &&
          getAfter(dataPath('invoices', request.resource.data.lastPaidInvoiceId)).data.status == 'paid' &&
          getAfter(dataPath('invoices', request.resource.data.lastPaidInvoiceId)).data.departmentId == departmentId &&
          request.resource.data.revenueMinor == resource.data.revenueMinor + getAfter(dataPath('invoices', request.resource.data.lastPaidInvoiceId)).data.totalMinor
      );
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      function canRead(d) {
        return active() && (d.kind == 'slot' || reception() || owns(d) || treating(d));
      }
      function scheduleMatches(d) {
        let department = get(dataPath('departments', d.departmentId)).data;
        let doctor = department.doctorProfiles[d.doctorId];
        let local = d.scheduledAt + duration.value(5, 'h');
        return department.active && doctor.active && department.doctorIds.hasAny([d.doctorId]) &&
          doctor.schedule.times.hasAny([d.time]) && doctor.schedule.weekdays.hasAny([local.dayOfWeek() % 7]) &&
          !doctor.schedule.closedDates.hasAny([d.date]) &&
          local.year() == int(d.date.split('-')[0]) && local.month() == int(d.date.split('-')[1]) &&
          local.day() == int(d.date.split('-')[2]) && local.hours() == int(d.time.split(':')[0]) &&
          local.minutes() == int(d.time.split(':')[1]) &&
          get(userPath(d.doctorId)).data.accountStatus == 'active';
      }
      function validSlot(d) {
        return d.kind == 'slot' && d.status in ['reserved', 'available'] && id(d.doctorId) && date(d.date) &&
          d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
          appointmentId == 'slot_' + d.doctorId + '_' + d.date + '_' + d.time.replace(':', '') &&
          (d.status == 'available' && d.appointmentId == null || d.status == 'reserved' && id(d.appointmentId) &&
            getAfter(dataPath('appointments', d.appointmentId)).data.doctorId == d.doctorId &&
            getAfter(dataPath('appointments', d.appointmentId)).data.date == d.date &&
            getAfter(dataPath('appointments', d.appointmentId)).data.time == d.time &&
            getAfter(dataPath('appointments', d.appointmentId)).data.slotId == appointmentId &&
            getAfter(dataPath('appointments', d.appointmentId)).data.status in ['scheduled', 'confirmed', 'checked-in', 'in-progress']);
      }
      function validAppointment(d) {
        return d.kind == 'appointment' && id(d.patientId) && id(d.doctorId) && id(d.departmentId) && date(d.date) &&
          d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && d.scheduledAt is timestamp &&
          d.status in ['scheduled', 'confirmed', 'checked-in', 'in-progress', 'completed', 'cancelled', 'no-show'] &&
          text(d.reason, 2000) && d.reason.size() > 0 && minor(d.consultationFeeMinor) &&
          d.paymentAmount == d.consultationFeeMinor / 100.0 && d.isEmergency is bool &&
          d.paymentStatus in ['unpaid', 'paid'] && d.triage in [null, 'red', 'yellow', 'green'];
      }
      allow get: if canRead(resource.data) || active() && !exists(dataPath('appointments', appointmentId));
      allow list: if bounded() && canRead(resource.data);
      allow create: if active() && createStamp(request.resource.data) && audit(request.resource.data, ['APPOINTMENT_CREATED', 'APPOINTMENT_RESCHEDULED']) && (
        validSlot(request.resource.data) ||
        validAppointment(request.resource.data) && (reception() || role('patient') && owns(request.resource.data)) &&
          request.resource.data.status == 'scheduled' && request.resource.data.scheduledAt > request.time &&
          request.resource.data.paymentStatus == 'unpaid' && request.resource.data.triage == null &&
          (!request.resource.data.isEmergency || reception() && get(dataPath('departments', request.resource.data.departmentId)).data.emergencyEnabled) &&
          get(userPath(request.resource.data.patientId)).data.role == 'patient' &&
          getAfter(dataPath('appointments', request.resource.data.slotId)).data.appointmentId == appointmentId && scheduleMatches(request.resource.data) &&
          request.resource.data.consultationFeeMinor == get(dataPath('departments', request.resource.data.departmentId)).data.doctorProfiles[request.resource.data.doctorId].consultationFeeMinor
      );
      allow update: if active() && updateStamp(request.resource.data) && (
        resource.data.kind == 'slot' && validSlot(request.resource.data) && changedOnly(['status', 'appointmentId']) &&
          audit(request.resource.data, ['APPOINTMENT_CREATED', 'APPOINTMENT_UPDATED', 'APPOINTMENT_RESCHEDULED', 'VISIT_DISCHARGED']) &&
          (resource.data.status == 'available' || request.resource.data.status == 'available' && (
            getAfter(dataPath('appointments', resource.data.appointmentId)).data.status in ['cancelled', 'no-show', 'completed'] ||
            getAfter(dataPath('appointments', resource.data.appointmentId)).data.slotId != appointmentId)) ||
        resource.data.kind == 'appointment' && validAppointment(request.resource.data) && (
          changedOnly(['status', 'statusReason', 'checkedInAt', 'checkedInBy']) && audit(request.resource.data, ['APPOINTMENT_UPDATED']) &&
            (resource.data.status in ['scheduled', 'confirmed'] && request.resource.data.status == 'cancelled' && (owns(resource.data) || treating(resource.data) || reception()) ||
             reception() && (resource.data.status == 'scheduled' && request.resource.data.status == 'confirmed' ||
               resource.data.status == 'confirmed' && request.resource.data.status == 'checked-in' ||
               resource.data.status in ['scheduled', 'confirmed'] && request.resource.data.status == 'no-show' && resource.data.scheduledAt < request.time)) ||
          (reception() || role('patient') && owns(resource.data)) && resource.data.status in ['scheduled', 'confirmed'] &&
            request.resource.data.status == 'scheduled' && request.resource.data.scheduledAt > request.time &&
            changedOnly(['date', 'time', 'scheduledAt', 'slotId', 'status', 'statusReason']) &&
            audit(request.resource.data, ['APPOINTMENT_RESCHEDULED']) && scheduleMatches(request.resource.data) &&
            getAfter(dataPath('appointments', request.resource.data.slotId)).data.appointmentId == appointmentId &&
            getAfter(dataPath('appointments', resource.data.slotId)).data.status == 'available' ||
          treating(resource.data) && changedOnly(['status', 'visitId', 'invoiceId']) && audit(request.resource.data, ['VISIT_CREATED', 'VISIT_DISCHARGED']) &&
            (resource.data.status == 'checked-in' && request.resource.data.status == 'in-progress' &&
              getAfter(dataPath('visits', appointmentId)).data.status == 'active' ||
             resource.data.status == 'in-progress' && request.resource.data.status == 'completed' &&
              getAfter(dataPath('visits', resource.data.visitId)).data.status == 'discharged') ||
          reception() && changedOnly(['paymentStatus']) && request.resource.data.paymentStatus == 'paid' &&
            audit(request.resource.data, ['PAYMENT_CONFIRMED']) && getAfter(dataPath('invoices', resource.data.invoiceId)).data.status == 'paid' ||
          reception() && resource.data.isEmergency && changedOnly(['triage', 'triagePriority', 'triageAssessment', 'triagedAt']) &&
            text(request.resource.data.triageAssessment, 2000) && audit(request.resource.data, ['TRIAGE_CLASSIFIED'])
        )
      );
      allow delete: if false;
    }

    match /visits/{visitId} {
      function valid(d) {
        return id(d.patientId) && id(d.doctorId) && id(d.departmentId) && d.appointmentId == visitId && d.invoiceId == visitId &&
          d.status in ['active', 'discharged'] && d.locked is bool && text(d.chiefComplaint, 2000) &&
          text(d.symptoms, 4000) && text(d.diagnosis, 4000) && text(d.notes, 6000) && d.vitals is map &&
          d.prescription is list && d.prescription.size() <= 30 &&
          d.openLabRequests is int && d.openLabRequests >= 0 && d.openLabRequests <= 10 &&
          d.openOperations is int && d.openOperations >= 0 && d.openOperations <= 5 &&
          (d.prescriptionPdf == null || file(d.prescriptionPdf) && d.prescriptionPdf.mimeType == 'application/pdf');
      }
      allow get: if clinicalRead(resource.data) || role('doctor') && !exists(dataPath('visits', visitId));
      allow list: if bounded() && clinicalRead(resource.data);
      allow create: if role('doctor') && valid(request.resource.data) && createStamp(request.resource.data) &&
        request.resource.data.doctorId == request.auth.uid && request.resource.data.status == 'active' && request.resource.data.locked == false &&
        get(dataPath('appointments', visitId)).data.status == 'checked-in' && get(dataPath('appointments', visitId)).data.doctorId == request.auth.uid &&
        request.resource.data.patientId == get(dataPath('appointments', visitId)).data.patientId &&
        request.resource.data.departmentId == get(dataPath('appointments', visitId)).data.departmentId &&
        getAfter(userPath(request.resource.data.patientId)).data.activeVisitId == visitId &&
        getAfter(dataPath('invoices', visitId)).data.visitId == visitId && audit(request.resource.data, ['VISIT_CREATED']);
      allow update: if updateStamp(request.resource.data) && valid(request.resource.data) && (
        changedOnly(['openLabRequests']) && resource.data.status == 'active' && resource.data.locked == false && (
          audit(request.resource.data, ['LAB_REQUEST_CREATED', 'LAB_REQUEST_CANCELLED']) && treating(resource.data) ||
          audit(request.resource.data, ['LAB_RESULT_UPLOADED']) && role('lab') && request.resource.data.openLabRequests == resource.data.openLabRequests - 1) ||
        changedOnly(['openOperations']) && resource.data.status == 'active' && resource.data.locked == false &&
          audit(request.resource.data, ['OPERATION_SCHEDULED', 'OPERATION_COMPLETED', 'OPERATION_CANCELLED']) && treating(resource.data) ||
        changedOnly(['chiefComplaint', 'symptoms', 'diagnosis', 'vitals', 'prescription', 'prescriptionPdf', 'followUpDate', 'notes']) && treating(resource.data) && resource.data.locked == false &&
          audit(request.resource.data, ['VISIT_UPDATED', 'PRESCRIPTION_ADDED']) ||
        changedOnly(['status', 'locked', 'dischargedAt', 'dischargeNotes']) && treating(resource.data) && resource.data.status == 'active' && resource.data.locked == false &&
          request.resource.data.status == 'discharged' && request.resource.data.locked == true &&
          resource.data.bedId == null && resource.data.openLabRequests == 0 && resource.data.openOperations == 0 &&
          request.resource.data.diagnosis.size() > 0 &&
          getAfter(userPath(resource.data.patientId)).data.activeVisitId == null && audit(request.resource.data, ['VISIT_DISCHARGED']) ||
        changedOnly(['locked', 'unlockedAt', 'unlockedBy', 'unlockReason']) && admin() && resource.data.status == 'discharged' && resource.data.locked && request.resource.data.locked == false &&
          text(request.resource.data.unlockReason, 2000) &&
          request.resource.data.unlockReason.size() > 0 && audit(request.resource.data, ['RECORD_UNLOCKED']) ||
        changedOnly(['locked']) && (admin() || treating(resource.data)) && resource.data.status == 'discharged' && resource.data.locked == false &&
          request.resource.data.locked && audit(request.resource.data, ['RECORD_RELOCKED']) ||
        changedOnly(['bedId']) && reception() && resource.data.status == 'active' && resource.data.locked == false &&
          audit(request.resource.data, ['BED_ASSIGNED', 'BED_RELEASED']) &&
          (request.resource.data.bedId == null || getAfter(dataPath('beds', request.resource.data.bedId)).data.visitId == visitId)
      );
      allow delete: if false;
    }

    match /invoices/{invoiceId} {
      function valid(d) {
        return id(d.patientId) && id(d.doctorId) && id(d.departmentId) && d.visitId == invoiceId && d.appointmentId == invoiceId &&
          d.items is list && d.items.size() > 0 && d.items.size() <= 100 && minor(d.subtotalMinor) && minor(d.taxMinor) && minor(d.totalMinor) &&
          d.taxBasisPoints == 0 && d.taxMinor == 0 && d.totalMinor == d.subtotalMinor &&
          d.total == d.totalMinor / 100.0 && d.subtotal == d.subtotalMinor / 100.0 && d.tax == 0 &&
          d.status in ['unpaid', 'pending_confirmation', 'paid'] && d.locked == (d.status == 'paid');
      }
      function validLine(line) {
        return id(line.id) && text(line.description, 200) && line.quantity is int && line.quantity > 0 && line.quantity <= 10000 &&
          minor(line.unitPriceMinor) && minor(line.amountMinor) && line.amountMinor == line.quantity * line.unitPriceMinor;
      }
      function sourceLine(line, d) {
        return line.sourceType == 'lab' && getAfter(dataPath('labRequests', line.sourceId)).data.invoiceId == invoiceId &&
          getAfter(dataPath('labRequests', line.sourceId)).data.status == 'pending' && line.quantity == 1 &&
          line.unitPriceMinor == getAfter(dataPath('labRequests', line.sourceId)).data.priceMinor ||
        line.sourceType == 'operation' && getAfter(dataPath('operations', line.sourceId)).data.invoiceId == invoiceId &&
          get(dataPath('operations', line.sourceId)).data.status == 'scheduled' && getAfter(dataPath('operations', line.sourceId)).data.status == 'in-progress' &&
          line.quantity == 1 && line.unitPriceMinor == getAfter(dataPath('operations', line.sourceId)).data.chargeMinor + getAfter(dataPath('operations', line.sourceId)).data.inventoryCostMinor ||
        line.sourceType == 'bed' && reception() && get(dataPath('beds', line.sourceId)).data.visitId == invoiceId &&
          line.id == get(dataPath('beds', line.sourceId)).data.sessionId && getAfter(dataPath('beds', line.sourceId)).data.status == 'available' &&
          line.unitPriceMinor == get(dataPath('beds', line.sourceId)).data.rateAtAssignmentMinor &&
          line.quantity >= (request.time.toMillis() - get(dataPath('beds', line.sourceId)).data.assignedAt.toMillis()) / 86400000.0 &&
          line.quantity <= (request.time.toMillis() - get(dataPath('beds', line.sourceId)).data.assignedAt.toMillis()) / 86400000.0 + 1;
      }
      function appended(d) {
        let old = resource.data;
        let last = d.items[d.items.size() - 1];
        return d.items.size() == old.items.size() + 1 && d.items.removeAll([last]) == old.items &&
          validLine(last) && sourceLine(last, d) && d.subtotalMinor == old.subtotalMinor + last.amountMinor;
      }
      allow get: if clinicalRead(resource.data) || reception() || role('doctor') && !exists(dataPath('invoices', invoiceId));
      allow list: if bounded() && (clinicalRead(resource.data) || reception());
      allow create: if role('doctor') && valid(request.resource.data) && createStamp(request.resource.data) &&
        request.resource.data.status == 'unpaid' && request.resource.data.doctorId == request.auth.uid &&
