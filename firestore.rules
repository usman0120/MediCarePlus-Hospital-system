         resource.data.status == 'delivered' && request.resource.data.status == 'seen') && audit(request.resource.data, ['CHAT_MESSAGES_READ']);
      allow delete: if false;
    }

    match /ratings/{ratingId} {
      allow get: if clinicalRead(resource.data) || role('patient') && !exists(dataPath('ratings', ratingId));
      allow list: if bounded() && clinicalRead(resource.data);
      allow create: if role('patient') && owns(request.resource.data) && createStamp(request.resource.data) &&
        request.resource.data.visitId == ratingId && request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 && text(request.resource.data.review, 2000) &&
        get(dataPath('visits', ratingId)).data.patientId == request.auth.uid && get(dataPath('visits', ratingId)).data.status == 'discharged' &&
        request.resource.data.doctorId == get(dataPath('visits', ratingId)).data.doctorId && audit(request.resource.data, ['DOCTOR_RATED']);
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow get: if admin();
      allow list: if admin() && bounded();
      allow create: if signedIn() && request.resource.data.schemaVersion == 2 &&
        request.resource.data.keys().hasOnly(['schemaVersion', 'actorId', 'userId', 'action', 'targetCollection', 'targetId', 'details', 'timestamp']) &&
        request.resource.data.actorId == request.auth.uid && request.resource.data.userId == request.auth.uid &&
        request.resource.data.timestamp == request.time && request.resource.data.details is map &&
        (request.resource.data.action in ['USER_LOGIN', 'USER_LOGOUT'] && active() && request.resource.data.targetCollection == 'users' &&
          request.resource.data.targetId == request.auth.uid ||
         getAfter(dataPath(request.resource.data.targetCollection, request.resource.data.targetId)).data.lastAuditId == logId &&
          getAfter(dataPath(request.resource.data.targetCollection, request.resource.data.targetId)).data.updatedBy == request.auth.uid);
      allow update, delete: if false;
    }
    // Legacy/unrecognized collections and every nested collection are denied.
    match /{document=**} { allow read, write: if false; }
  }
}
