# Firebase web configuration is public, not an administrator credential.
# Enforce authorization using Firestore rules, not secrecy of these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false
VITE_ENABLE_TOTP=false
VITE_ENABLE_PHONE_AUTH=false

# Server-only provisioning: NEVER prefix these with VITE_.
# Set in your shell when running scripts/reset-firebase.mjs, not the browser.
# GOOGLE_APPLICATION_CREDENTIALS=absolute-path-to-service-account.json
# MEDICARE_ADMIN_EMAIL=
# MEDICARE_ADMIN_PASSWORD=
